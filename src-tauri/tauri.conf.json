{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strife Delivery",
  "version": "0.1.0",
  "identifier": "com.omnypro.strifedelivery",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Strife Delivery",
        "url": "index.html",
        "width": 404,
        "height": 239,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "focus": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Countdown widget for upcoming games",
    "longDescription": "A little desktop widget that counts down to the games you're waiting on.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCOTJFRTczQjY0N0ZFRkIKUldUNy9rZTJjKzZTS3p6NVE5TGpTRVcvRDM0bFMwSU1sQnR3U0pxdWpjMDQ0dm02WHJsZ3hCUnQK",
      "endpoints": [
        "https://github.com/omnypro/strife-delivery/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
